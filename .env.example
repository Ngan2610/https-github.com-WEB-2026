# Chỉ là ví dụ, KHÔNG chứa mật khẩu thật.
# Nếu đã có Docker/SSMS chạy ổn định: GIỮ NGUYÊN .env cũ, KHÔNG chép đè.
DB_PASSWORD=SET_YOUR_EXISTING_SQL_PASSWORD_HERE
TOKEN_SECRET=GENERATE_UNIQUE_RANDOM_32PLUS_CHARACTERS
ADMIN_EMAIL=admin@dubchef.vn
ADMIN_PASSWORD=
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
DB_TRUST_SERVER_CERTIFICATE=true
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PAYMENT_MODE=disabled
OLLAMA_MODEL=qwen2.5:3b
# Optional private-service secrets; set identical values on API and matching service.
TRANSLATION_INTERNAL_TOKEN=
RENDER_INTERNAL_TOKEN=

# Server-side Whisper STT; model cached in dubchef-whisper volume.
WHISPER_MODEL=small
TRANSCRIPTION_INTERNAL_TOKEN=
# For running job-worker outside Docker; Docker sets the internal URL automatically.
TRANSCRIPTION_SERVICE_URL=http://127.0.0.1:4300
