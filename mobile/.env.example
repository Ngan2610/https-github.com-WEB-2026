# Chỉ là cấu hình công khai. KHÔNG đặt token, mật khẩu SQL hay khóa payOS vào biến EXPO_PUBLIC_.
# Biến này được "nướng" vào bundle lúc build: đổi xong phải chạy lại `npx expo start -c`.
# Chọn ĐÚNG MỘT dòng, bỏ dấu # ở đầu dòng đó.

# 1) Máy ảo Android trên laptop (10.0.2.2 = laptop; API Docker ở cổng 4000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# 2) Điện thoại thật cùng Wi-Fi riêng (chạy `npm run lan`; thay bằng IPv4 Wi-Fi từ `ipconfig`)
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5173/backend
#    Nếu mã QR của Expo ra sai IP (card ảo WSL/Docker), đặt thêm trong PowerShell:
#    $env:REACT_NATIVE_PACKAGER_HOSTNAME="192.168.1.20"

# 3) APK / giảng viên ở xa: BẮT BUỘC HTTPS (APK release chặn http://)
# EXPO_PUBLIC_API_URL=https://staging.example.invalid/backend
